# Portas dos Serviços
GATEWAY_PORT=8000
FRONTEND_PORT=3000
USER_SERVICE_PORT=8001
GAME_SERVICE_PORT=8002
RANK_SERVICE_PORT=8003
SUPPORT_SERVICE_PORT=8004

# URLs Internas para o Gateway
USER_SERVICE_URL=http://localhost:8001
GAME_SERVICE_URL=http://localhost:8002
RANK_SERVICE_URL=http://localhost:8003
SUPPORT_SERVICE_URL=http://localhost:8004

# Bancos de Dados
# PostgreSQL (User & Support)
POSTGRES_USER=gamehub
POSTGRES_PASSWORD=gamehub_secret
POSTGRES_DB=gamehub_user_db
POSTGRES_SUPPORT_DB=gamehub_support_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MongoDB (Game Service)
MONGO_URI=mongodb://localhost:27017/gamehub_games

# Redis (Rank Service / Cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secret
JWT_SECRET=super_secret_gamehub_jwt_key
